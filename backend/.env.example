# MySQL (docker-compose.yml 의 mysql 컨테이너). 처음 기동할 때 이 값으로 DB·계정을 만든다.
# 컨테이너 안에서는 DB_HOST=mysql 로 고정되므로 여기 값은 compose 밖에서 실행할 때만 쓴다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eatomato
DB_USERNAME=eatomato
# 생성: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT 서명 키 (32바이트 이상). 생성: openssl rand -base64 48
JWT_SECRET=

# 프론트 출처(쉼표 구분)
# 로컬 개발에서 백엔드만 띄워 붙일 때는 http://localhost:3000 을 더한다(운영에는 넣지 않는다).
CORS_ALLOWED_ORIGINS=https://eatomato.kr,https://www.eatomato.kr

# 업로드 파일 URL 앞부분 (브라우저에서 접근 가능한 백엔드 주소)
PUBLIC_BASE_URL=https://eatomato.kr

# 상품 테이블이 비어 있으면 프론트 mock 과 같은 데모 데이터를 넣는다
SEED_DEMO_DATA=true

# 로그인은 카카오·네이버만 받는다(아이디·비밀번호 로그인은 꺼져 있음).
# 관리자는 카카오·네이버로 가입한 계정에 관리자 화면(또는 DB 의 member.role)에서 ADMIN 권한을 준다.

# 카카오 로그인 (Kakao Developers > 앱 키 / 보안)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 Redirect URI 와 같아야 한다(쉼표 구분)
KAKAO_REDIRECT_URIS=https://eatomato.kr/login/kakao/
# 휴대전화번호·연계정보(CI)를 가입 필수로 받을지(true/false). 카카오 비즈 앱 심사로 phone_number·account_ci
# 동의항목을 연 뒤에 true 로 켠다. 켜면 기존 회원도 다음 로그인 때 두 항목 동의 화면을 본다.
KAKAO_REQUIRE_PHONE_CI=false

# 네이버 로그인 (네이버 개발자센터 > 내 애플리케이션 > Client ID / Client Secret)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 콘솔에 등록한 Callback URL 과 같아야 한다(쉼표 구분)
NAVER_REDIRECT_URIS=https://eatomato.kr/login/naver/

# 결제: mock(항상 승인, 개발용) 또는 toss(토스페이먼츠 결제위젯)
PAYMENT_PROVIDER=mock
# 토스페이먼츠 개발자센터 > API 키 > "결제위젯 연동 키" (test_gck_ / test_gsk_, 운영은 live_)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 마케팅 인사이트 에이전트(관리자 > 마케팅 인사이트, ../insight-agent)
# 켜려면 아래 네 줄을 채운다. COMPOSE_PROFILES=insight 가 있어야 deploy.sh 가 워커 컨테이너를 함께 띄운다.
# 워커와 백엔드가 주고받는 공유 토큰. 생성: openssl rand -hex 32
INSIGHT_AGENT_TOKEN=
# Claude API 키(console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# 기본 claude-haiku-5-5(가장 저렴). 품질 비교 뒤 바꿀 수 있다
INSIGHT_MODEL=
COMPOSE_PROFILES=

# 카카오 알림톡(솔라피, console.solapi.com). 결제완료·상품준비중·배송시작·취소환불을 받는 분 연락처로 보낸다.
# 비어 있으면 보내지 않는다(발송 기록에 SKIPPED).
# 솔라피 > 개발/연동 > API Key 관리
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 연결한 카카오 비즈니스 채널 ID(KA01PF...)
SOLAPI_PF_ID=
# 솔라피에 등록한 발신번호(알림톡 실패 시 문자 대체 발송)
SOLAPI_SENDER=
# 카카오 검수를 받은 템플릿 ID(KA01TP...). 변수 이름은 backend/README.md '카카오 알림톡' 참고
ALIMTALK_TEMPLATE_ORDER_PAID=
ALIMTALK_TEMPLATE_ORDER_PREPARING=
ALIMTALK_TEMPLATE_ORDER_SHIPPING=
ALIMTALK_TEMPLATE_ORDER_CANCELLED=
