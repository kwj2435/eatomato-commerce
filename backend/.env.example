# Azure Database for MySQL
DB_HOST=eatomato-db.mysql.database.azure.com
DB_PORT=3306
DB_NAME=eatomato
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키 (32바이트 이상). 생성: openssl rand -base64 48
JWT_SECRET=

# 프론트 출처(쉼표 구분)
CORS_ALLOWED_ORIGINS=https://eatomato.kr,https://www.eatomato.kr,https://kwj2435.github.io,http://localhost:3000

# 업로드 파일 URL 앞부분 (브라우저에서 접근 가능한 백엔드 주소)
PUBLIC_BASE_URL=https://eatomato.kr

# 상품 테이블이 비어 있으면 프론트 mock 과 같은 데모 데이터를 넣는다
SEED_DEMO_DATA=true

# 첫 관리자 계정. 기동 시 없으면 만들고, 있으면 관리자 권한만 준다(비밀번호는 덮어쓰지 않음).
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# 카카오 로그인 (Kakao Developers > 앱 키 / 보안)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 Redirect URI 와 같아야 한다(쉼표 구분)
KAKAO_REDIRECT_URIS=https://eatomato.kr/login/kakao/,http://localhost:3000/login/kakao/

# 결제: mock(항상 승인, 개발용) 또는 toss(토스페이먼츠 결제위젯)
PAYMENT_PROVIDER=mock
# 토스페이먼츠 개발자센터 > API 키 > "결제위젯 연동 키" (test_gck_ / test_gsk_, 운영은 live_)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
